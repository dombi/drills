rules_version = '2';
// Unikornis Centum — Firestore biztonsági szabályok (backend 1. fázis)
// Telepítés: Firebase konzol → Firestore Database → Rules fül → ide bemásolni → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Játékos: csak a saját adatait látja és írja
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /unicorns/{uniId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Eseménynapló: mindenki csak a saját nevében írhat bele, olvasni csak az admin (3. fázis)
    match /events/{eid} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }

    // Producer-beállítások, csoportok (4. fázis): az admin írja, a játékos a sajátját olvassa
    match /producerConfig/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /groups/{gid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
  }
}
